<Project Sdk="Microsoft.NET.Sdk">
  <!-- func-signallog-api: Query and Admin HTTP API behind Entra ID (ADR 0005, ADR 0006, ADR 0013). -->

  <PropertyGroup>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SignalLog.Contracts\SignalLog.Contracts.csproj" />
    <ProjectReference Include="..\SignalLog.Domain\SignalLog.Domain.csproj" />
    <ProjectReference Include="..\SignalLog.Observability\SignalLog.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
